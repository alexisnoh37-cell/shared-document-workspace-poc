# 실행 모드: memory(로컬 UI/흐름 시연) 또는 supabase(실제 Auth/RLS/Storage)
APP_BACKEND=memory
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-long-random-value
SESSION_COOKIE_SECURE=false
SESSION_FILE_DIR=instance/sessions

# 메모리 데모 모드의 16개 계정에 공통으로 적용할 런타임 비밀번호
# 실제 운영 비밀번호로 사용하지 마세요.
DEMO_ACCOUNT_PASSWORD=

# Supabase 모드
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 데모 계정 seed와 관리자 작업에만 사용하며 브라우저에 노출하지 않습니다.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=workspace-files

# 파일/문서 비교
MAX_UPLOAD_MB=25
KORDOC_NODE_BIN=node
KORDOC_TIMEOUT_SECONDS=60

# HWPX 웹 편집. 실제 업무 배포에서는 검증된 자체 호스팅 rhwp-studio URL을 권장합니다.
RHWP_EDITOR_ENABLED=false
# 실시간 공동편집 기능. 안정 버전에서는 false로 유지합니다.
COLLAB_EDITOR_ENABLED=false
# 조각 편집중 실시간 표시: 락 유휴 자동 해제(분)와 화면 폴링 주기(초)
COLLAB_LOCK_IDLE_MINUTES=30
COLLAB_POLL_SECONDS=3
RHWP_STUDIO_URL=https://edwardkim.github.io/rhwp/
# 데모 sample_files의 load/export 회귀를 수동 확인할 때만 활성화합니다.
RHWP_SPIKE_ENABLED=false
